**/node_modules/
**/__pycache__/
*.pyc
books/tools/
**/tools/zulu17-jre/
**/tools/zulu17-jre.zip

# LifeBook Launcher local build cache. These directories are regenerated by
# `npm install`, `npm run build`, or `npm run tauri:build`.
tools/lifebook-launcher/source/dist/
tools/lifebook-launcher/source/src-tauri/target/
tools/lifebook-launcher/source/src-tauri/gen/
.playwright-mcp/
launcher-console.txt
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
books/*/*/output/epub_work/
books/*/*/state/*.log
books/*/*/assets/**/cover_source*.png
books/*/*/assets/**/cover_background*.png
books/*/*/output/cover_source*.png
books/*/*/output/cover_source_prompt.txt
books/*/*/output/cover_fixed_centered*.png

# Repository-level checks must not create a confusing shared book output dir.
books/output/

# Large source/QA evidence stays local; keep rights/source notes, checksums,
# small necessary crops, and final EPUB-facing assets in Git.
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/source/facsimile/*.pdf
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/qa/technical/page_screenshots/almagest-pdf-page-*.png
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/qa/technical/page_screenshots/*contact_sheet*.jpg
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/qa/technical/page_screenshots/*contact_sheet*.png
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/qa/technical/page_screenshots/book_i11_page_028_large.jpg
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/preproduction/stage2_sample/facsimile_work/source_pages/
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/preproduction/stage2_sample/facsimile_work/*contact*.jpg
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/preproduction/stage2_sample/facsimile_work/*contact*.png
books/zh-Hans/6_ptolemy_almagest_grc_zh_hans/preproduction/stage2_sample/facsimile_work/debug_*.png

# Legacy large fallback cover; final cover.jpg remains tracked.
books/zh-Hans/1_pg20923_a_negro_explorer_at_the_north_pole/assets/cover.png

# Launcher installers are published as project release attachments.
tools/lifebook-launcher/*.exe

# Local Codex/agent instructions and environment notes.
# Keep project-specific operational preferences here instead of global memory.
.codex/

# Local private docs should never be tracked.
doc/private/

# User-provided non-public-domain book projects are private local output.
# Scripts and templates may be tracked, but private source text, translations,
# QA records, and EPUB artifacts under this tree must never be published.
books/private/**
!books/private/
!books/private/.gitignore

# Book-specific screenshot/debug captures must stay under the matching book project.
/almagest-*.png
/lifebook-*.png
