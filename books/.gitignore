# Book-project publish policy.
# By default, books/{target}/{number_slug}/ production trees are local working
# state. GitHub tracks only versioned release artifacts under output/release/.
# Keep one complete reference project below so downloaded copies still show the
# expected book-project directory structure.

private/

*/*/*
!*/*/output/
*/*/output/*
!*/*/output/release/
!*/*/output/release/**

!zh-Hans/7_shisei_tanizaki/
!zh-Hans/7_shisei_tanizaki/**

# Shared local-only tool cache. Use scripts/setup_local_tools.py to inspect or
# populate it; third-party runtimes and archives must not be committed.
tools/

# Build/cache output copied or regenerated during EPUB production.
*/*/output/epub_work/
*/*/output/*epub_source*/
*/*/output/cover_source*.png
*/*/output/cover_source_prompt.txt
*/*/output/cover_fixed_centered*.png

# Preproduction generated packages and facsimile work directories.
*/*/preproduction/**/sample_book.epub
*/*/preproduction/**/facsimile_work/

# Local run logs and language/runtime caches.
*/*/state/*.log
*/*/**/__pycache__/
*/*/**/*.pyc

# Generated cover/source drafts. Final cover.jpg and EPUB-facing assets remain tracked.
*/*/assets/**/cover_source*.png
*/*/assets/**/cover_background*.png

# QA generated binary evidence and scanner dumps. Keep Markdown/JSON review results tracked.
*/*/qa/**/*.png
*/*/qa/**/*.jpg
*/*/qa/**/*.jpeg
*/*/qa/**/*.webp
*/*/qa/**/*.log
*/*/qa/**/*.tmp
*/*/qa/**/*.cache
*/*/qa/**/*_rg_scan.txt
*/*/qa/**/*rg_scan*.txt
